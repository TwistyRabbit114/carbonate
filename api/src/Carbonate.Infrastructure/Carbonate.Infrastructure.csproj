<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Carbonate.Application\Carbonate.Application.csproj" />
    <ProjectReference Include="..\Carbonate.Domain\Carbonate.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FR-31 file storage. Azure.Identity gives the managed identity that signs user-delegation
         SAS links, so no storage account key exists anywhere (docs/hosting.md). -->
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- BackgroundService for EventTransitionWorker (FR-02); Abstractions alone has only IHostedService. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <!-- Not used directly. Pinned because it arrives transitively at 9.0.11, which carries
         CVE-2026-84008 (GHSA-846f-f764-76mx): SignedCms.CheckSignature reparses attacker-controlled
         X.509 data, so an unauthenticated caller can exhaust CPU. 10.0.13 is the patched release on
         the 10.x line and matches the rest of the solution. Lifting it here also lifts
         Carbonate.Api and both test projects, which reference this one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Carbonate.UnitTests" />
    <InternalsVisibleTo Include="Carbonate.IntegrationTests" />
  </ItemGroup>

</Project>
